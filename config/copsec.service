[Unit]
Description=CoPSeC Enterprise Threat Prevention Engine
Documentation=https://github.com/CoPdasten/copsec
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/copsec
Environment="COPSEC_SHM_HMAC_KEY=copsec_production_secure_hmac_secret_2026"
ExecStart=/usr/local/bin/copsec
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
