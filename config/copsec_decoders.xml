<?xml version="1.0" encoding="UTF-8"?>
<decoder name="copsec_json">
    <plugin_decoder>JSON</plugin_decoder>
</decoder>

<decoder name="copsec_agent">
    <parent>copsec_json</parent>
    <type>json</type>
</decoder>

<decoder name="copsec_ip_banned">
    <parent>copsec_agent</parent>
    <prematch>^{.*\"event_code\":\"IP_BANNED\"</prematch>
    <plugin_decoder>JSON</plugin_decoder>
</decoder>

<decoder name="copsec_threat_detection">
    <parent>copsec_agent</parent>
    <prematch>^{.*\"event_code\":\"THREAT\"</prematch>
    <plugin_decoder>JSON</plugin_decoder>
</decoder>

<decoder name="copsec_suricata_alert">
    <parent>copsec_agent</parent>
    <prematch>^{.*\"event_code\":\"SURICATA_ALERT\"</prematch>
    <plugin_decoder>JSON</plugin_decoder>
</decoder>

<decoder name="copsec_mitre_mapping">
    <parent>copsec_agent</parent>
    <prematch>^{.*\"mitre_technique_id\"</prematch>
    <plugin_decoder>JSON</plugin_decoder>
</decoder>