      "regex": "(?i)(systemctl[[:space:]]+(stop|disable|mask)[[:space:]]+(ufw|nftables|firewalld|apparmor)|service[[:space:]]+(ufw|nftables|firewalld)[[:space:]]+stop|ufw[[:space:]]+disable)",
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Defense Evasion",
      "mitre_tactic_id": "TA0005",
      "mitre_technique_id": "T1562.001",
      "mitre_technique_name": "Impair Defenses: Disable or Modify Tools",
      "mitre": {
        "tactic": "Defense Evasion",
        "tactic_id": "TA0005",
        "technique_id": "T1562.001",
        "technique_name": "Impair Defenses: Disable or Modify Tools",
        "url": "https://attack.mitre.org/techniques/T1562/001/"
      }
    },
