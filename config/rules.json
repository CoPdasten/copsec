{
  "suricata": {
    "eve_file": "/var/log/suricata/eve.json",
    "fast_file": "/var/log/suricata/fast.log",
    "enabled": true,
    "missing_logs_are_nonfatal": true
  },
  "anomaly_mitre": {
    "OBFUSCATED_PAYLOAD": {
      "tactic": "Defense Evasion",
      "technique_id": "T1027",
      "technique_name": "Obfuscated Files or Information"
    },
    "RECON_SCANNER": {
      "tactic": "Reconnaissance",
      "technique_id": "T1595.002",
      "technique_name": "Vulnerability Scanning"
    },
    "DECOY_TRAP": {
      "tactic": "Reconnaissance",
      "technique_id": "T1595",
      "technique_name": "Active Scanning"
    },
    "DECOY_TRAP_TRIGGERED": {
      "tactic": "Reconnaissance",
      "technique_id": "T1595",
      "technique_name": "Active Scanning"
    },
    "SURICATA_ALERT": {
      "tactic": "Initial Access",
      "technique_id": "T1190",
      "technique_name": "Exploit Public-Facing Application"
    }
  },
  "monitored_paths": [
    "/var/log/",
    "/var/log/nginx/",
    "/var/log/apache2/",
    "/var/log/suricata/"
  ],
  "rules": [
    {
      "id": "nginx-web-scan",
      "name": "Nginx Web Vulnerability Scan",
      "category": "web",
      "log_file": "/var/log/apache2/access.log",
      "log_files": [
        "/var/log/nginx/access.log",
        "/var/log/apache2/access.log"
      ],
      "regex": "(?i)(/admin|\\.env|wp-login\\.php|config\\.php|\\.git|\\.htaccess|phpmyadmin)",
      "status_codes": [400, 403, 404, 500],
      "action": "ban",
      "ban_duration": 7200,
      "max_attempts": 3,
      "find_time": 60,
      "mitre_tactic": "Reconnaissance",
      "mitre_tactic_id": "TA0043",
      "mitre_technique_id": "T1595.002",
      "mitre_technique_name": "Vulnerability Scanning",
      "mitre": {
        "tactic": "Reconnaissance",
        "tactic_id": "TA0043",
        "technique_id": "T1595.002",
        "technique_name": "Vulnerability Scanning",
        "url": "https://attack.mitre.org/techniques/T1595/002/"
      }
    },
    {
      "id": "obfuscated-payload",
      "name": "Obfuscated Web Payload Attempt",
      "category": "web",
      "log_file": "/var/log/apache2/access.log",
      "log_files": [
        "/var/log/nginx/access.log",
        "/var/log/apache2/access.log"
      ],
      "regex": "(?i)(%25[0-9a-f]{2}|\\x[0-9a-f]{2}|\\\\u00[0-9a-f]{2}|base64_decode|eval\\s*\\()",
      "status_codes": [400, 403, 404, 500],
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Defense Evasion",
      "mitre_tactic_id": "TA0005",
      "mitre_technique_id": "T1027",
      "mitre_technique_name": "Obfuscated Files or Information",
      "mitre": {
        "tactic": "Defense Evasion",
        "tactic_id": "TA0005",
        "technique_id": "T1027",
        "technique_name": "Obfuscated Files or Information",
        "url": "https://attack.mitre.org/techniques/T1027/"
      }
    },
    {
      "id": "ssrf-metadata-attempt",
      "name": "SSRF Cloud Instance Metadata Access",
      "category": "web",
      "log_file": "/var/log/apache2/access.log",
      "log_files": [
        "/var/log/nginx/access.log",
        "/var/log/apache2/access.log"
      ],
      "regex": "(?i)(169\\.254\\.169\\.254|metadata\\.google|metadata\\.internal|latest/meta-data|latest/api/token)",
      "status_codes": [400, 403, 404, 500],
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Credential Access",
      "mitre_tactic_id": "TA0006",
      "mitre_technique_id": "T1552.005",
      "mitre_technique_name": "Unsecured Credentials: Cloud Instance Metadata API",
      "mitre": {
        "tactic": "Credential Access",
        "tactic_id": "TA0006",
        "technique_id": "T1552.005",
        "technique_name": "Unsecured Credentials: Cloud Instance Metadata API",
        "url": "https://attack.mitre.org/techniques/T1552/005/"
      }
    },
    {
      "id": "ssh-password-spraying",
      "name": "SSH Failed Authentication / Password Spraying",
      "category": "ssh",
      "log_file": "/var/log/auth.log",
      "log_files": [
        "/var/log/auth.log",
        "/var/log/secure"
      ],
      "regex": "(?i)(Failed password for|Invalid user|authentication failure|maximum authentication attempts exceeded|too many authentication failures)",
      "action": "ban",
      "ban_duration": 3600,
      "max_attempts": 3,
      "find_time": 60,
      "mitre_tactic": "Credential Access",
      "mitre_tactic_id": "TA0006",
      "mitre_technique_id": "T1110.001",
      "mitre_technique_name": "Password Spraying",
      "mitre": {
        "tactic": "Credential Access",
        "tactic_id": "TA0006",
        "technique_id": "T1110.001",
        "technique_name": "Password Spraying",
        "url": "https://attack.mitre.org/techniques/T1110/001/"
      }
    },
    {
      "id": "sqli-attempt",
      "name": "SQL Injection Attack",
      "category": "web",
      "log_file": "/var/log/apache2/access.log",
      "log_files": [
        "/var/log/nginx/access.log",
        "/var/log/apache2/access.log"
      ],
      "regex": "(?i)(select%20|union%20select|concat\\(|'--|%27%20or%20|or%201=1|sleep\\(|benchmark\\(|;[[:space:]]*(select|insert|update|delete))",
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Initial Access",
      "mitre_tactic_id": "TA0001",
      "mitre_technique_id": "T1190",
      "mitre_technique_name": "Exploit Public-Facing Application",
      "mitre": {
        "tactic": "Initial Access",
        "tactic_id": "TA0001",
        "technique_id": "T1190",
        "technique_name": "Exploit Public-Facing Application",
        "url": "https://attack.mitre.org/techniques/T1190/"
      }
    },
    {
      "id": "xss-reflected",
      "name": "Cross-Site Scripting Reflected",
      "category": "web",
      "log_file": "/var/log/apache2/access.log",
      "log_files": [
        "/var/log/nginx/access.log",
        "/var/log/apache2/access.log"
      ],
      "regex": "(?i)(<script|javascript:|onerror=|onload=|eval\\(|document\\.cookie|alert\\()",
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Initial Access",
      "mitre_tactic_id": "TA0001",
      "mitre_technique_id": "T1189",
      "mitre_technique_name": "Drive-by Compromise",
      "mitre": {
        "tactic": "Initial Access",
        "tactic_id": "TA0001",
        "technique_id": "T1189",
        "technique_name": "Drive-by Compromise",
        "url": "https://attack.mitre.org/techniques/T1189/"
      }
    },
    {
      "id": "path-traversal-lfi",
      "name": "Path Traversal and Local File Inclusion",
      "category": "lfi",
      "log_file": "/var/log/apache2/access.log",
      "log_files": [
        "/var/log/nginx/access.log",
        "/var/log/apache2/access.log"
      ],
      "regex": "(?i)(\\.\\./|%2e%2e%2f|/etc/passwd|/etc/shadow|/proc/self/(environ|cmdline)|/var/log/auth\\.log)",
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Execution",
      "mitre_tactic_id": "TA0002",
      "mitre_technique_id": "T1059",
      "mitre_technique_name": "Command and Scripting Interpreter",
      "mitre": {
        "tactic": "Execution",
        "tactic_id": "TA0002",
        "technique_id": "T1059",
        "technique_name": "Command and Scripting Interpreter",
        "url": "https://attack.mitre.org/techniques/T1059/"
      }
    },
    {
      "id": "rce-command-injection",
      "name": "Remote Code Execution / Command Injection",
      "category": "rce",
      "log_file": "/var/log/apache2/access.log",
      "log_files": [
        "/var/log/nginx/access.log",
        "/var/log/apache2/access.log"
      ],
      "regex": "(?i)(;[[:space:]]*(cat|id|whoami|sh)|\\|[[:space:]]*id|\\$\\(whoami\\)|&&[[:space:]]*(netstat|ss)|/bin/(sh|bash)|nc[[:space:]].*-e|/dev/tcp/|python[0-9.]*[[:space:]]+-c[[:space:]]+.*socket)",
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Execution",
      "mitre_tactic_id": "TA0002",
      "mitre_technique_id": "T1059.004",
      "mitre_technique_name": "Unix Shell",
      "mitre": {
        "tactic": "Execution",
        "tactic_id": "TA0002",
        "technique_id": "T1059.004",
        "technique_name": "Unix Shell",
        "url": "https://attack.mitre.org/techniques/T1059/004/"
      }
    },
    {
      "id": "etc-shadow-access",
      "name": "Credential Access via /etc/shadow or /etc/passwd",
      "category": "auth",
      "log_file": "/var/log/auth.log",
      "log_files": [
        "/var/log/auth.log",
        "/var/log/secure"
      ],
      "regex": "(?i)(/etc/(shadow|passwd)|cat[[:space:]]+.*(shadow|passwd)|openssl[[:space:]]+passwd)",
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Credential Access",
      "mitre_tactic_id": "TA0006",
      "mitre_technique_id": "T1003.008",
      "mitre_technique_name": "OS Credential Dumping: /etc/passwd and /etc/shadow",
      "mitre": {
        "tactic": "Credential Access",
        "tactic_id": "TA0006",
        "technique_id": "T1003.008",
        "technique_name": "OS Credential Dumping: /etc/passwd and /etc/shadow",
        "url": "https://attack.mitre.org/techniques/T1003/008/"
      }
    },
    {
      "id": "log-clearing-file-deletion",
      "name": "Indicator Removal: File Deletion and Log Clearing",
      "category": "auth",
      "log_file": "/var/log/auth.log",
      "log_files": [
        "/var/log/auth.log",
        "/var/log/secure"
      ],
      "regex": "(?i)(rm[[:space:]]+-rf[[:space:]]+/var/log|rm[[:space:]].*/var/log|truncate[[:space:]].*/var/log|shred[[:space:]].*/var/log|history[[:space:]]+-c|\\>/?var/log)",
      "action": "ban",
      "ban_duration": 86400,
      "max_attempts": 1,
      "find_time": 60,
      "mitre_tactic": "Defense Evasion",
      "mitre_tactic_id": "TA0005",
      "mitre_technique_id": "T1070.004",
      "mitre_technique_name": "File Deletion",
      "mitre": {
        "tactic": "Defense Evasion",
        "tactic_id": "TA0005",
        "technique_id": "T1070.004",
        "technique_name": "File Deletion",
        "url": "https://attack.mitre.org/techniques/T1070/004/"
      }
    },
    {
      "id": "disable-firewall-services",
      "name": "Impair Defenses: Disable Firewall Services",
      "category": "auth",
      "log_file": "/var/log/auth.log",
      "log_files": [
        "/var/log/auth.log",
        "/var/log/secure"
